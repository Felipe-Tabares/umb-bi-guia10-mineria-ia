digraph F {
  rankdir=TB; bgcolor="white"; pad=0.2; nodesep=0.35; ranksep=0.35;
  node [shape=box, style="rounded", fontname="Arial", fontsize=10, color="#333333", penwidth=1.1];
  edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.7];
  inicio [label="Inicio", shape=oval];
  existe [label="¿Existe la base\nal lado del programa?", shape=diamond];
  carga [label="Leer datos_iniciales/clientes.csv\ny validar cada fila"];
  entrena [label="Entrenar K-means k = 4\n(misma receta del análisis)"];
  igual [label="¿Da los mismos grupos\nque el archivo?", shape=diamond];
  usa [label="Modelo = el entrenado"];
  promedia [label="Respetar los grupos del archivo;\ncentroide = promedio de cada grupo"];
  ventana [label="Abrir ventana: tabla, gráfica\ny panel de grupos"];
  accion [label="¿Qué hace el usuario?", shape=diamond];
  form [label="Leer formulario"];
  valida [label="Validar: código, país, recencia,\nfrecuencia, valor, unidades, productos"];
  ok [label="¿Válido y sin repetir?", shape=diamond];
  error [label="Mostrar el motivo en rojo\n(no se guarda nada)"];
  asigna [label="Calcular estado y mercado;\ngrupo = centroide más cercano"];
  k [label="Leer k"];
  kok [label="¿2 <= k <= 8?", shape=diamond];
  km [label="log1p + StandardScaler +\nKMeans(n_init = 20, random_state = 42)"];
  renum [label="Renumerar por valor medio;\nnombres; silueta y Davies-Bouldin"];
  guarda [label="Guardar en SQLite y registrar\nen la bitácora con su reversa"];
  refresca [label="Redibujar tabla, gráfica\ny perfil de grupos"];
  fin [label="Cerrar", shape=oval];
  inicio -> existe;
  existe -> carga [label="no"]; existe -> ventana [label="sí"];
  carga -> entrena -> igual;
  igual -> usa [label="sí"]; igual -> promedia [label="no"];
  usa -> ventana; promedia -> ventana;
  ventana -> accion;
  accion -> form [label="Agregar o editar"];
  accion -> k [label="Recalcular grupos"];
  accion -> fin [label="Cerrar"];
  form -> valida -> ok;
  ok -> error [label="no"]; ok -> asigna [label="sí"];
  error -> accion [style=dashed];
  asigna -> guarda;
  k -> kok; kok -> error [label="no"]; kok -> km [label="sí"];
  km -> renum -> guarda;
  guarda -> refresca -> accion [style=dashed];
}
